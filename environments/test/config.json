{
  "gitlab_base_url": "https://gitlab.test.example.internal/api/v4/",
  "artifactory_url": "https://jfrog.test.example.internal/artifactory",
  "gitlab": {
    "groups": {
      "engineering": { "name": "Engineering Test", "path": "engineering-test" }
    },
    "projects": {
      "application": { "name": "Sample Application", "path": "sample-application", "group_key": "engineering" }
    }
  },
  "artifactory": {
    "groups": { "platform-test-readers": {} },
    "local_generic_repositories": { "platform-test-generic-local": {} },
    "local_docker_repositories": { "platform-test-docker-local": {} },
    "permission_targets": {
      "platform-test-read": {
        "repositories": ["platform-test-generic-local", "platform-test-docker-local"],
        "group_permissions": { "platform-test-readers": ["read"] }
      }
    }
  }
}